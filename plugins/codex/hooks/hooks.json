{
  "description": "Dispatch explicit $x prompt commands through Komut.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/x\" --hook",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\x.cmd\" --hook",
            "timeout": 5,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
