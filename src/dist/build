#!/bin/sh
set -eu

root=$(CDPATH= cd "$(dirname "$0")/../.." && pwd)
out=${1:-"$root/dist"}
plugins='codex claude opencode antigravity'

rm -rf "$out"

for plugin in $plugins; do
        mkdir -p "$out/plugins/$plugin/bin" "$out/plugins/$plugin/libexec/x"
        cp -R "$root/src/adapters/$plugin/." "$out/plugins/$plugin/"
        cp "$root/bin/x" "$out/plugins/$plugin/bin/x"
        cp "$root/bin/x.cmd" "$out/plugins/$plugin/bin/x.cmd"
        chmod 0755 "$out/plugins/$plugin/bin/x"
done

chmod 0755 "$out/plugins/claude/hooks/run.cmd"

build() {
        goos=$1
        goarch=$2
        target=$3
        name=$4
        temp="$out/.build/$target/$name"

        mkdir -p "$(dirname "$temp")"
        (
                cd "$root/src"
                CGO_ENABLED=0 GOOS=$goos GOARCH=$goarch \
                        go build -trimpath -ldflags="-s -w" \
                        -o "$temp" ./cmd/x
        )

        for plugin in $plugins; do
                dir="$out/plugins/$plugin/libexec/x/$target"
                mkdir -p "$dir"
                cp "$temp" "$dir/$name"
        done
}

build darwin arm64 darwin-arm64 x
build darwin amd64 darwin-amd64 x
build linux arm64 linux-arm64 x
build linux amd64 linux-amd64 x
build windows amd64 windows-amd64 x.exe

rm -rf "$out/.build"
